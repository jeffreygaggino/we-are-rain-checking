# Copy to .env for local development. .env is gitignored; this file is not.
#
# DB_HOST, DB_NAME, DB_USER and DB_PASSWORD have no defaults in the loader. Leaving one out is a
# startup failure rather than a zero value that surfaces later as a connection mystery.

PORT=8080
PUBLIC_URL=localhost:8080
API_BASE_PATH=/api/v1

# The serving mode defaults to release, so the deployed service does not announce debug or print its
# whole route table at boot. It does still log a line per request, health checks included — that
# comes from gin's logger middleware, which no mode turns off. Local development is where the boot
# output is wanted, so this is the one place it gets turned back on — deliberately, and visibly, here.
GIN_MODE=debug

# Which proxies may be believed about the client address, as a comma-separated list of IPs or CIDRs.
# Empty trusts none, so ClientIP() is the peer address and an X-Forwarded-For from any caller is
# ignored. Nothing reads ClientIP() yet; the deployment behind a proxy names its address here when
# something does.
TRUSTED_PROXIES=

DB_HOST=localhost
DB_PORT=55432
DB_NAME=rainchecking
DB_USER=rainchecking
DB_PASSWORD=rainchecking
DB_SCHEMA=f1

# TLS to the database is on by default. The local compose Postgres does not serve TLS, so local
# development is the one place this gets turned down — deliberately, and visibly, here.
DB_SSLMODE=disable

OPENF1_BASE_URL=https://api.openf1.org/v1
OPENMETEO_BASE_URL=https://api.open-meteo.com/v1
UPSTREAM_TIMEOUT=10s
FORECAST_CACHE_TTL=1h

# OpenF1 documents 30 req/min. 2100ms between calls keeps ingest under that and under the 3 req/s
# ceiling at the same time.
INGEST_MIN_INTERVAL=2100ms
